# ---- Data provider selection ----
# fixture (default, zero external deps) | sleeper | csv
LEAGUE_PROVIDER=fixture

# ---- Database ----
# SQLite for local dev. Swap to a postgres:// URL + set provider="postgresql"
# in prisma/schema.prisma for production. No SQLite-only types are used.
DATABASE_URL="file:./dev.db"

# ---- Sleeper (only used when LEAGUE_PROVIDER=sleeper) ----
# Resolved for EZ8 / NSL Fantasy Hoops, current 2026 season.
SLEEPER_USERNAME=EZ8
SLEEPER_LEAGUE_ID=1347007735815766016

# ---- Analyst (optional) ----
# Without a key the analyst degrades to a deterministic rules-based summary.
ANTHROPIC_API_KEY=
ANALYST_MODEL=claude-sonnet-5

# ---- Player photos (optional, default off) ----
# NBA/Getty headshots are NOT licensed for redistribution. Personal/local use only.
NEXT_PUBLIC_USE_PLAYER_PHOTOS=false
