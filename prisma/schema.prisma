// Prisma schema. POSTGRES - the move D10 planned for has happened, and the datasource
// below is no longer switchable by editing one word.
//
// Still portable by construction: no engine-specific column types are used, JSON is
// stored as String, ids are String, timestamps are DateTime. What changed is the
// setup instruction. DATABASE_URL must now be a postgres:// URL; the `file:./dev.db`
// value this comment used to recommend cannot connect, and since D36 a DATABASE_URL
// that is set but unusable fails a ledger write loudly (500, "Your note was NOT
// saved") rather than falling through to the friendly no-database path. Leaving
// DATABASE_URL UNSET is still fully supported and still gets that friendly path:
// reads are DB-free (D18) and a zero-config deploy works (D21).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// The user's captured reasoning for a transaction — the Decision Ledger.
/// Keyed by the immutable Sleeper transaction_id so re-ingests never orphan it.
///
/// One row per (transactionId, ownerId), NOT per transactionId alone. A trade has
/// two sides that share one transactionId, so without an author column a note
/// written by one participant is indistinguishable from a note written by the
/// other — the exact bug this column exists to fix (an annotation captured under
/// one manager's own team was rendered as another manager's "stated posture" the
/// moment the viewer switched teams).
model Annotation {
  id            String   @id @default(cuid())
  transactionId String
  /// The durable author identity — the Sleeper platform user id, i.e. a PRINCIPAL's
  /// ownerId (DECISIONS.md D22), never a roster id. Roster ids get REASSIGNED
  /// between seasons on a handover; ownerId does not, so it is the only identity
  /// that stays correct for as long as the annotation itself does.
  ownerId       String
  /// Free text — "what has to be true for this to work" reasoning.
  reasoning     String
  /// Optional one-tap posture tag captured alongside the free text.
  posture       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([transactionId, ownerId])
  @@index([createdAt])
  @@index([ownerId])
}

/// Persisted copy of every ingested transaction. Enables (a) new-transaction
/// detection by diffing ingests, (b) an offline/ fixture-backed ledger, and
/// (c) re-derivation without re-fetching. Payload is the full domain Transaction
/// as stringified JSON (Postgres-portable; swap to Json type on Postgres if wanted).
model IngestedTransaction {
  transactionId String   @id
  leagueId      String
  season        String
  week          Int
  type          String
  createdMs     BigInt
  creator       String?
  /// Stringified domain Transaction.
  payload       String
  firstSeenAt   DateTime @default(now())

  @@index([season])
  @@index([type])
}

/// Cache of the players payload (Sleeper /players/nba is 2.3MB). One row per run.
model PlayerCacheEntry {
  playerId    String   @id
  fullName    String
  position    String?
  team        String?
  age         Int?
  searchRank  Int?
  /// Stringified domain Player.
  payload     String
  updatedAt   DateTime @updatedAt
}

/// Simple key/value bookkeeping (last ingest time, resolved league id, provider).
model Meta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
