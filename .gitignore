# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright (e2e/)
/test-results/
/playwright-report/
/blob-report/
# sandbox-local Chromium executablePath override - never portable, see
# ~/.claude/skills/web-qa-tooling/SKILL.md
playwright.config.verify.mjs

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local database (SQLite dev)
/prisma/*.db
/prisma/*.db-journal
*.sqlite

# ingested data cache
/data/cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
